# Server Configuration
NODE_ENV=development
PORT=3000

# Database
# Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - from Render)
# DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-openssl-rand-base64-32

# AI Configuration - Google Gemini (Primary)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp

# AI Configuration - Ollama (Optional Local Alternative)
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# CORS - Frontend URL
CLIENT_URL=http://localhost:5173
