generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  firstName         String?
  lastName          String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  profile           CandidateProfile?
  interviewSessions InterviewSession[]
  skillProgress     UserSkillProgress[]

  @@map("users")
}

model CandidateProfile {
  id              String                @id @default(uuid())
  userId          String                @unique @map("user_id")
  targetRole      String                @map("target_role")
  experienceLevel String                @map("experience_level")
  industry        String?
  interviewMode   String                @default("mock") @map("interview_mode")
  durationMinutes Int                   @default(30) @map("duration_minutes")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  focusAreas      CandidateFocusArea[]
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  technologies    CandidateTechnology[]

  @@map("candidate_profiles")
}

model CandidateTechnology {
  profileId  String           @map("profile_id")
  technology String
  profile    CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, technology])
  @@map("candidate_technologies")
}

model CandidateFocusArea {
  profileId String           @map("profile_id")
  focusArea String           @map("focus_area")
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, focusArea])
  @@map("candidate_focus_areas")
}

model Skill {
  id               String              @id @default(uuid())
  name             String              @unique
  description      String?
  category         String
  questionSkills   QuestionSkill[]
  skillAssessments SkillAssessment[]
  userProgress     UserSkillProgress[]

  @@map("skills")
}

model UserSkillProgress {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  skillId    String    @map("skill_id")
  score      Float?
  confidence Float?
  attempts   Int       @default(0)
  lastTested DateTime? @map("last_tested")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  skill      Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skill_progress")
}

model Question {
  id                 String              @id @default(uuid())
  title              String
  content            String
  difficulty         String
  type               String
  technology         String?
  industry           String?
  expectedAnswer     String?             @map("expected_answer")
  followUpHints      String[]            @default([]) @map("follow_up_hints")
  timeLimit          Int?                @map("time_limit")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  interviewQuestions InterviewQuestion[]
  skills             QuestionSkill[]

  @@map("questions")
}

model QuestionSkill {
  questionId String   @map("question_id")
  skillId    String   @map("skill_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([questionId, skillId])
  @@map("question_skills")
}

model InterviewSession {
  id               String              @id @default(uuid())
  userId           String              @map("user_id")
  status           String              @default("created")
  mode             String
  targetRole       String              @map("target_role")
  level            String
  technologies     String[]            @default([])
  industry         String?
  duration         Int
  startedAt        DateTime?           @map("started_at")
  endedAt          DateTime?           @map("ended_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  messages         InterviewMessage[]
  questions        InterviewQuestion[]
  report           InterviewReport?
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillAssessments SkillAssessment[]

  @@map("interview_sessions")
}

model InterviewMessage {
  id        BigInt           @id @default(autoincrement())
  sessionId String           @map("session_id")
  speaker   String
  content   String
  type      String           @default("transcript")
  createdAt DateTime         @default(now()) @map("created_at")
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("interview_messages")
}

model InterviewQuestion {
  id         String           @id @default(uuid())
  sessionId  String           @map("session_id")
  questionId String           @map("question_id")
  order      Int
  askedAt    DateTime         @default(now()) @map("asked_at")
  question   Question         @relation(fields: [questionId], references: [id])
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, order])
  @@map("interview_questions")
}

model SkillAssessment {
  id         BigInt           @id @default(autoincrement())
  sessionId  String           @map("session_id")
  skillId    String           @map("skill_id")
  score      Float?
  confidence Float?
  evidence   Json             @default("[]")
  assessedAt DateTime         @default(now()) @map("assessed_at")
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skill      Skill            @relation(fields: [skillId], references: [id])

  @@map("skill_assessments")
}

model InterviewReport {
  id              String           @id @default(uuid())
  sessionId       String           @unique @map("session_id")
  overallScore    Float?           @map("overall_score")
  strengths       String[]
  weaknesses      String[]
  recommendations String[]
  nextSteps       String[]         @map("next_steps")
  generatedAt     DateTime         @default(now()) @map("generated_at")
  session         InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("interview_reports")
}

model LearningPlan {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  title          String
  description    String?
  priority       Int      @default(1)
  status         String   @default("active")
  targetSkills   String[] @map("target_skills")
  estimatedHours Float?   @map("estimated_hours")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("learning_plans")
}
